<form autocomplete="off" class="ionrift-sound-config"
    style="display: flex; flex-direction: column; height: 100%; overflow: hidden;">

    <!-- Main Layout Container -->
    <div style="display: flex; flex: 1; overflow: hidden;">

        <!-- Sidebar Navigation -->
        <nav class="ionrift-sidebar tabs" style="flex: 0 0 220px; display: flex; flex-direction: column;">

            <!-- Top Group: Tiers -->
            <div class="sidebar-group tiers" style="flex: 0 0 auto;">
                <div class="header">{{localize "ionrift-resonance.config.tiersHeader"}}</div>
                <div class="group-items" style="display: flex; flex-direction: column; gap: 2px;">
                    <a class="item" data-tab="tier1"><i class="fas fa-cube"></i> {{localize "ionrift-resonance.config.tabEssentials"}}</a>
                    <a class="item" data-tab="tier2"><i class="fas fa-hammer"></i> {{localize "ionrift-resonance.config.tabCombatActions"}}</a>
                    <a class="item" data-tab="tier3"><i class="fas fa-skull"></i> {{localize "ionrift-resonance.config.tabMonsters"}}</a>
                    {{#if features.sharedMonsterVoices}}
                    <a class="item" data-tab="shared-monster"><i class="fas fa-users"></i> {{localize "ionrift-resonance.config.tabSharedMonsterVoices"}}</a>
                    {{/if}}
                    <!-- <a class="item" data-tab="tier4"><i class="fas fa-cloud-showers-heavy"></i> Weather</a> -->
                </div>
            </div>

            <!-- Module Integrations -->
            <div class="sidebar-group integrations" style="flex: 0 0 auto; margin-top: 10px;">
                <div class="header {{#unless integrations.hasActive}}dimmed-header{{/unless}}">{{localize "ionrift-resonance.config.integrationsHeader"}}</div>
                <div class="group-items" style="display: flex; flex-direction: column; gap: 2px;">
                    <a class="item {{#unless integrations.quizNight.active}}disabled-tab{{/unless}}" 
                       data-tab="quiz-night" 
                       {{#unless integrations.quizNight.active}}title="{{localize "ionrift-resonance.config.integration.quizNightNotActiveTitle"}}"{{/unless}}>
                        <i class="fas fa-question-circle"></i> {{localize "ionrift-resonance.config.integration.tabQuizNight"}}
                        {{#unless integrations.quizNight.active}}
                        <span class="integration-status-tag">{{localize "ionrift-resonance.config.integration.statusInactive"}}</span>
                        {{else unless integrations.quizNight.compatible}}
                        <span class="integration-status-tag" style="background: rgba(245, 158, 11, 0.25); color: #fbbf24; border-color: rgba(245, 158, 11, 0.4);" title="{{localize "ionrift-resonance.config.integration.updateRequiredTooltip" version=integrations.quizNight.version minVersion=integrations.quizNight.minVersion}}">{{localize "ionrift-resonance.config.integration.statusOutdated"}}</span>
                        {{/unless}}
                    </a>
                    <a class="item {{#unless integrations.respite.active}}disabled-tab{{/unless}}" 
                       data-tab="respite" 
                       {{#unless integrations.respite.active}}title="{{localize "ionrift-resonance.config.integration.respiteNotActiveTitle"}}"{{/unless}}>
                        <i class="fas fa-campground"></i> {{localize "ionrift-resonance.config.integration.tabRespite"}}
                        {{#unless integrations.respite.active}}
                        <span class="integration-status-tag">{{localize "ionrift-resonance.config.integration.statusInactive"}}</span>
                        {{else unless integrations.respite.compatible}}
                        <span class="integration-status-tag" style="background: rgba(245, 158, 11, 0.25); color: #fbbf24; border-color: rgba(245, 158, 11, 0.4);" title="{{localize "ionrift-resonance.config.integration.updateRequiredTooltip" version=integrations.respite.version minVersion=integrations.respite.minVersion}}">{{localize "ionrift-resonance.config.integration.statusOutdated"}}</span>
                        {{/unless}}
                    </a>
                    <a class="item {{#unless integrations.cursewright.active}}disabled-tab{{/unless}}" 
                       data-tab="cursewright" 
                       {{#unless integrations.cursewright.active}}title="{{localize "ionrift-resonance.config.integration.cursewrightNotActiveTitle"}}"{{/unless}}>
                        <i class="fas fa-ring"></i> {{localize "ionrift-resonance.config.integration.tabCursewright"}}
                        {{#unless integrations.cursewright.active}}
                        <span class="integration-status-tag">{{localize "ionrift-resonance.config.integration.statusInactive"}}</span>
                        {{else unless integrations.cursewright.compatible}}
                        <span class="integration-status-tag" style="background: rgba(245, 158, 11, 0.25); color: #fbbf24; border-color: rgba(245, 158, 11, 0.4);" title="{{localize "ionrift-resonance.config.integration.updateRequiredTooltip" version=integrations.cursewright.version minVersion=integrations.cursewright.minVersion}}">{{localize "ionrift-resonance.config.integration.statusOutdated"}}</span>
                        {{/unless}}
                    </a>
                    <a class="item {{#unless integrations.voice.active}}disabled-tab{{/unless}}" 
                       data-tab="voice" 
                       {{#unless integrations.voice.active}}title="{{localize "ionrift-resonance.config.integration.voiceNotActiveTitle"}}"{{/unless}}>
                        <i class="fas fa-comment-dots"></i> {{localize "ionrift-resonance.config.integration.tabVoice"}}
                        {{#unless integrations.voice.active}}
                        <span class="integration-status-tag">{{localize "ionrift-resonance.config.integration.statusInactive"}}</span>
                        {{else unless integrations.voice.compatible}}
                        <span class="integration-status-tag" style="background: rgba(245, 158, 11, 0.25); color: #fbbf24; border-color: rgba(245, 158, 11, 0.4);" title="{{localize "ionrift-resonance.config.integration.updateRequiredTooltip" version=integrations.voice.version minVersion=integrations.voice.minVersion}}">{{localize "ionrift-resonance.config.integration.statusOutdated"}}</span>
                        {{/unless}}
                    </a>
                    <a class="item {{#unless integrations.tripwire.active}}disabled-tab{{/unless}}" 
                       data-tab="tripwire" 
                       {{#unless integrations.tripwire.active}}title="{{localize "ionrift-resonance.config.integration.tripwireNotActiveTitle"}}"{{/unless}}>
                        <i class="fas fa-dungeon"></i> {{localize "ionrift-resonance.config.integration.tabTripwire"}}
                        {{#unless integrations.tripwire.active}}
                        <span class="integration-status-tag">{{localize "ionrift-resonance.config.integration.statusInactive"}}</span>
                        {{else unless integrations.tripwire.compatible}}
                        <span class="integration-status-tag" style="background: rgba(245, 158, 11, 0.25); color: #fbbf24; border-color: rgba(245, 158, 11, 0.4);" title="{{localize "ionrift-resonance.config.integration.updateRequiredTooltip" version=integrations.tripwire.version minVersion=integrations.tripwire.minVersion}}">{{localize "ionrift-resonance.config.integration.statusOutdated"}}</span>
                        {{/unless}}
                    </a>
                    <a class="item {{#unless integrations.luminance.active}}disabled-tab{{/unless}}" 
                       data-tab="luminance" 
                       {{#unless integrations.luminance.active}}title="{{localize "ionrift-resonance.config.integration.luminanceNotActiveTitle"}}"{{/unless}}>
                        <i class="fas fa-fire-flame-simple"></i> {{localize "ionrift-resonance.config.integration.tabLuminance"}}
                        {{#unless integrations.luminance.active}}
                        <span class="integration-status-tag">{{localize "ionrift-resonance.config.integration.statusInactive"}}</span>
                        {{else unless integrations.luminance.compatible}}
                        <span class="integration-status-tag" style="background: rgba(245, 158, 11, 0.25); color: #fbbf24; border-color: rgba(245, 158, 11, 0.4);" title="{{localize "ionrift-resonance.config.integration.updateRequiredTooltip" version=integrations.luminance.version minVersion=integrations.luminance.minVersion}}">{{localize "ionrift-resonance.config.integration.statusOutdated"}}</span>
                        {{/unless}}
                    </a>
                    <a class="item {{#unless integrations.waterline.active}}disabled-tab{{/unless}}" 
                       data-tab="waterline" 
                       {{#unless integrations.waterline.active}}title="{{localize "ionrift-resonance.config.integration.waterlineNotActiveTitle"}}"{{/unless}}>
                        <i class="fas fa-water"></i> {{localize "ionrift-resonance.config.integration.tabWaterline"}}
                        {{#unless integrations.waterline.active}}
                        <span class="integration-status-tag">{{localize "ionrift-resonance.config.integration.statusInactive"}}</span>
                        {{else unless integrations.waterline.compatible}}
                        <span class="integration-status-tag" style="background: rgba(245, 158, 11, 0.25); color: #fbbf24; border-color: rgba(245, 158, 11, 0.4);" title="{{localize "ionrift-resonance.config.integration.updateRequiredTooltip" version=integrations.waterline.version minVersion=integrations.waterline.minVersion}}">{{localize "ionrift-resonance.config.integration.statusOutdated"}}</span>
                        {{/unless}}
                    </a>
                </div>
            </div>

            <div style="flex: 1;"></div> <!-- Spacer -->

            <!-- Bottom Group: Tools -->
            <div class="sidebar-group tools" style="flex: 0 0 auto; margin-bottom: 10px;">
                <div class="header">{{localize "ionrift-resonance.config.toolsHeader"}}</div>
                <div class="group-items">
                    <a class="item auditor-tab" data-tab="auditor"><i class="fas fa-search"></i> {{localize "ionrift-resonance.config.tabSoundAuditor"}}</a>
                    <a class="item" data-tab="orchestrator"><i class="fas fa-sliders-h"></i> {{localize "ionrift-resonance.config.tabOrchestration"}}</a>
                </div>
            </div>
        </nav>

        <!-- Content Area -->
        <section class="content" style="flex: 1; padding: 10px; overflow-y: auto; background: rgba(0,0,0,0.2);">

            <!-- TIER 1: CORE (Hierarchical) -->
            <div class="tab" data-tab="tier1">
                <div class="ionrift-hierarchy">
                    <div class="ionrift-list-header"><i class="fas fa-cube"></i> {{localize "ionrift-resonance.config.tabEssentials"}}</div>

                    {{#each tiers.tier1.paramounts as |group|}}
                    {{> "modules/ionrift-resonance/templates/partials/sound-group.hbs" group}}
                    {{/each}}
                </div>
            </div>

            <!-- TIER 2: ACTIONS (Hierarchical) -->
            <div class="tab" data-tab="tier2">
                <div class="ionrift-hierarchy">
                    <div class="ionrift-list-header"><i class="fas fa-hammer"></i> {{localize "ionrift-resonance.config.actionTaxonomyHeader"}}</div>

                    {{#each tiers.tier2.paramounts as |group|}}
                    {{> "modules/ionrift-resonance/templates/partials/sound-group.hbs" group}}
                    {{/each}}
                </div>
            </div>

            <!-- TIER 3: MONSTERS (Hierarchical) -->
            <div class="tab" data-tab="tier3">
                <div class="ionrift-hierarchy">
                    <div class="ionrift-list-header"><i class="fas fa-skull"></i> {{localize "ionrift-resonance.config.monsterTaxonomyHeader"}}</div>

                    {{#each tiers.tier3.paramounts as |group|}}
                    {{> "modules/ionrift-resonance/templates/partials/sound-group.hbs" group}}
                    {{/each}}
                </div>
            </div>

            <!-- SHARED MONSTER VOICES -->
            {{#if features.sharedMonsterVoices}}
            <div class="tab" data-tab="shared-monster">
                <div class="ionrift-hierarchy">
                    <div class="ionrift-list-header"><i class="fas fa-users"></i> {{localize "ionrift-resonance.config.tabSharedMonsterVoices"}}</div>

                    <p style="font-size:0.85em; opacity:0.65; margin: 0 0 14px 0; padding: 0 4px;">
                        <i class="fas fa-info-circle"></i>
                        {{{localize "ionrift-resonance.config.sharedMonsterVoicesDesc"}}}
                    </p>

                    {{#each tiers.sharedMonster.paramounts as |group|}}
                    {{> "modules/ionrift-resonance/templates/partials/sound-group.hbs" group}}
                    {{/each}}
                </div>
            </div>
            {{/if}}

            <!-- QUIZ NIGHT INTEGRATION -->
            <div class="tab" data-tab="quiz-night">
                <div class="ionrift-hierarchy">
                    <div class="ionrift-list-header"><i class="fas fa-question-circle"></i> {{localize "ionrift-resonance.config.integration.headerQuizNight"}}</div>

                    {{#if integrations.quizNight.active}}
                        {{#if integrations.quizNight.compatible}}
                        <p style="font-size:0.85em; opacity:0.65; margin: 0 0 14px 0; padding: 0 4px;">
                            <i class="fas fa-info-circle"></i>
                            {{localize "ionrift-resonance.config.integration.quizNightDesc"}}
                        </p>

                        {{#each tiers.quizNight.paramounts as |group|}}
                        {{> "modules/ionrift-resonance/templates/partials/sound-group.hbs" group}}
                        {{/each}}
                        {{else}}
                        <div class="integration-inactive-banner" style="margin: 30px auto; padding: 24px; background: rgba(245, 158, 11, 0.1); border: 1px dashed rgba(245, 158, 11, 0.4); border-radius: 8px; text-align: center; max-width: 480px;">
                            <i class="fas fa-triangle-exclamation" style="font-size: 2.2em; color: #f59e0b; margin-bottom: 12px; display: block;"></i>
                            <h3 style="margin: 0 0 8px 0; opacity: 0.95; font-size: 1.1em; color: #fbbf24;">{{localize "ionrift-resonance.config.integration.quizNightUpdateTitle"}}</h3>
                            <p style="margin: 0; font-size: 0.88em; opacity: 0.8; line-height: 1.4;">
                                {{{localize "ionrift-resonance.config.integration.quizNightUpdateDesc" version=integrations.quizNight.version minVersion=integrations.quizNight.minVersion}}}
                            </p>
                        </div>
                        {{/if}}
                    {{else}}
                    <div class="integration-inactive-banner" style="margin: 30px auto; padding: 24px; background: rgba(0,0,0,0.25); border: 1px dashed rgba(255,255,255,0.15); border-radius: 8px; text-align: center; max-width: 480px;">
                        <i class="fas fa-plug" style="font-size: 2.2em; opacity: 0.35; margin-bottom: 12px; display: block;"></i>
                        <h3 style="margin: 0 0 8px 0; opacity: 0.9; font-size: 1.1em;">{{localize "ionrift-resonance.config.integration.quizNightNotActiveHeading"}}</h3>
                        <p style="margin: 0; font-size: 0.88em; opacity: 0.65; line-height: 1.4;">
                            {{{localize "ionrift-resonance.config.integration.quizNightNotActiveDesc"}}}
                        </p>
                    </div>
                    {{/if}}
                </div>
            </div>

