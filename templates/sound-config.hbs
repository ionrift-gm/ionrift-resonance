                                    <td style="text-align:center; padding: 5px 6px; opacity:0.5; font-size:0.9em;">
                                        {{this.defaultMs}}ms</td>
                                    <td style="padding: 4px 6px; text-align:center;">
                                        <input type="number" class="orchestrator-offset-input" data-offset="{{this.id}}"
                                            value="{{this.overrideMs}}" placeholder="{{this.defaultMs}}" min="0"
                                            step="50"
                                            style="width:80px; text-align:center; background:rgba(255,255,255,0.07); border:1px solid {{#if this.accentBorder}}rgba(124,58,237,0.6){{else}}rgba(255,255,255,0.15){{/if}}; color:#fff; padding:2px 4px; border-radius:3px;">
                                    </td>
                                    <td style="text-align:center; padding: 4px 6px;">
                                        <button type="button" class="orchestrator-reset-offset"
                                            data-offset="{{this.id}}" title="{{localize "ionrift-resonance.config.resetToDefaultLower"}}"
                                            style="display:{{#if this.hasOverride}}inline-block{{else}}none{{/if}}; width:26px; height:26px; padding:0; font-size:0.8em; background:rgba(200,120,80,0.2); border:1px solid rgba(200,120,80,0.3); color:#c84; border-radius:3px; cursor:pointer;">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>

