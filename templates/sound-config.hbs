        style="flex: 0 0 auto; background: rgba(20, 20, 30, 0.95); padding: 8px 14px; border-top: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: row; justify-content: space-between; align-items: center; gap: 10px; min-height: 46px; width: 100%; box-sizing: border-box;">
        <div class="sheet-footer-left" style="display: flex; flex-direction: row; align-items: center; gap: 8px; width: auto; flex: 0 0 auto;">
            {{#if hasSyrinscape}}
            <button type="button" class="stop-all-sounds" title="{{localize "ionrift-resonance.config.stopAllTitle"}}"
                style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 30px; line-height: 1; padding: 0 12px; font-size: 0.85em; white-space: nowrap; width: auto; background: rgba(185, 28, 28, 0.2); border: 1px solid rgba(185, 28, 28, 0.5); color: #fca5a5; border-radius: 4px; cursor: pointer; flex: 0 0 auto;">
                <i class="fas fa-stop-circle"></i> {{localize "ionrift-resonance.config.stopAllBtn"}}
            </button>
            <div class="sheet-footer-divider" style="width: 1px; height: 16px; background: rgba(255, 255, 255, 0.12); margin: 0 2px; flex: 0 0 auto;"></div>
            {{/if}}
            <button type="button" class="load-preset" title="{{localize "ionrift-resonance.config.audioModeTitle"}}"
                style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 30px; line-height: 1; padding: 0 10px; font-size: 0.85em; white-space: nowrap; width: auto; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.18); color: rgba(255, 255, 255, 0.72); border-radius: 4px; cursor: pointer; flex: 0 0 auto; transition: all 0.15s ease;">
                <i class="fas fa-volume-up"></i> {{localize "ionrift-resonance.config.audioModeBtn"}}
            </button>
            <button type="button" class="import-config" title="{{localize "ionrift-resonance.config.importTitle"}}"
                style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 30px; line-height: 1; padding: 0 10px; font-size: 0.85em; white-space: nowrap; width: auto; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.18); color: rgba(255, 255, 255, 0.72); border-radius: 4px; cursor: pointer; flex: 0 0 auto; transition: all 0.15s ease;">
