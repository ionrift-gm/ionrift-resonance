                        <button type="button" class="orchestrator-reset-all"
                            style="background:rgba(124,58,237,0.08); border:1px solid rgba(124,58,237,0.2); color:rgba(180,160,255,0.65); padding:4px 12px; border-radius:3px; font-size:0.85em; cursor:pointer;">
                            <i class="fas fa-undo"></i> {{localize "ionrift-resonance.config.resetAllToDefaults"}}
