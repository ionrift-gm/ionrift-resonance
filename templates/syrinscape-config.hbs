<form class="syrinscape-config-form {{cssClass}}" autocomplete="off">
    <div class="syrinscape-config-body">
        <header class="syrinscape-config-header">
            <p class="syrinscape-config-lead">
                <i class="fas fa-volume-up syrinscape-config-lead-icon"></i>
                {{localize "ionrift-resonance.syrinscape.leadTitle"}}
            </p>
            <p class="notes syrinscape-config-intro">
                {{localize "ionrift-resonance.syrinscape.introNotes"}}
            </p>
        </header>

        {{{tokenPanel}}}

        {{#if mismatch}}
        <div class="syrinscape-mismatch-banner token-mismatch-warning">
            <i class="fas fa-exclamation-triangle"></i> <strong>{{localize "ionrift-resonance.syrinscape.tokenMismatchTitle"}}</strong>
            <p class="syrinscape-mismatch-detail">
                {{localize "ionrift-resonance.syrinscape.tokenMismatchDetail"}}
            </p>
            <button type="button" data-action="sync" class="syrinscape-sync-btn">
                <i class="fas fa-sync-alt"></i> {{localize "ionrift-resonance.syrinscape.syncToControlBtn"}}
            </button>
        </div>
        {{/if}}
    </div>

    <footer class="sheet-footer syrinscape-config-footer flexrow">
        <button type="submit" name="submit" class="syrinscape-footer-btn">
            <i class="fas fa-save"></i> {{{localize "ionrift-resonance.syrinscape.saveAndClose"}}}
        </button>
    </footer>
</form>
