<div class="ionrift-cascade-ui">
    <!-- Header: The Arcane Blueprint -->
    <header class="cascade-header">
        <h1><i class="fas fa-project-diagram"></i> {{localize "ionrift-resonance.cascade.headerTitle"}}</h1>
        <div class="cascade-meta">
            <span class="status-indicator active"><i class="fas fa-circle"></i> {{localize "ionrift-resonance.cascade.engineOnline"}}</span>
            <span class="mode-indicator">{{localize "ionrift-resonance.cascade.modeVisceral"}}</span>
        </div>
    </header>

    <!-- Main Workspace: The Blueprint -->
    <div class="cascade-workspace">

        <!-- Column 1: Triggers (The Roll) -->
        <div class="column triggers">
            <h2><i class="fas fa-dice-d20"></i> {{localize "ionrift-resonance.cascade.columnTriggers"}}</h2>
            <div class="node-container">
                <div class="node trigger active" data-type="attack">
                    <div class="node-header">{{localize "ionrift-resonance.cascade.nodeAttackRoll"}}</div>
                    <div class="node-body">
                        <span class="value">D20 + 5</span>
                    </div>
                    <div class="connector-point right"></div>
                </div>

                <div class="node trigger" data-type="damage">
                    <div class="node-header">{{localize "ionrift-resonance.cascade.nodeDamageRoll"}}</div>
                    <div class="node-body">
                        <span class="value">2d6 + 3</span>
                    </div>
                    <div class="connector-point right"></div>
                </div>
            </div>
        </div>

        <!-- Connection Lines (SVG Overlay) -->
        <!-- We will mock these with CSS/SVG in the background for the screenshot -->

        <!-- Column 2: Context (The Logic) -->
        <div class="column context">
            <h2><i class="fas fa-balance-scale"></i> {{localize "ionrift-resonance.cascade.columnLogicGate"}}</h2>
            <div class="node-container">
                <div class="node logic active critical" data-result="crit">
                    <div class="connector-point left"></div>
                    <div class="node-header">{{localize "ionrift-resonance.cascade.nodeCriticalHit"}}</div>
                    <div class="node-body">
                        <span class="condition">{{localize "ionrift-resonance.cascade.condNatural20"}}</span>
                    </div>
                    <div class="connector-point right"></div>
                </div>

                <div class="node logic" data-result="hit">
                    <div class="connector-point left"></div>
                    <div class="node-header">{{localize "ionrift-resonance.cascade.nodeStandardHit"}}</div>
                    <div class="node-body">
                        <span class="condition">{{{localize "ionrift-resonance.cascade.condRollGtAc"}}}</span>
                    </div>
                    <div class="connector-point right"></div>
                </div>

                <div class="node logic" data-result="miss">
                    <div class="connector-point left"></div>
                    <div class="node-header">{{localize "ionrift-resonance.cascade.nodeMiss"}}</div>
                    <div class="node-body">
                        <span class="condition">{{{localize "ionrift-resonance.cascade.condRollLtAc"}}}</span>
                    </div>
                    <div class="connector-point right"></div>
                </div>
            </div>
        </div>

        <!-- Column 3: Output (The Sound) -->
        <div class="column output">
            <h2><i class="fas fa-volume-up"></i> {{localize "ionrift-resonance.cascade.columnManifestation"}}</h2>
            <div class="node-container">
                <div class="node sound active" data-sound="crit-chime">
                    <div class="connector-point left"></div>
                    <div class="node-header">{{localize "ionrift-resonance.cascade.nodeVisceralImpact"}}</div>
                    <div class="node-body">
                        <i class="fas fa-music"></i>
                        <span class="sound-name">Blade_Crit_Chime_01</span>
                    </div>
                    <div class="waveform-viz">
                        <!-- CSS Animation of bars -->
                        <span class="bar"></span><span class="bar"></span><span class="bar"></span><span
                            class="bar"></span>
                    </div>
                </div>

                <div class="node sound" data-sound="hit-flesh">
                    <div class="connector-point left"></div>
                    <div class="node-header">{{localize "ionrift-resonance.cascade.nodePhysicalImpact"}}</div>
                    <div class="node-body">
                        <i class="fas fa-tired"></i>
                        <span class="sound-name">Flesh_Tear_Wet</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Inspector Panel (Bottom) -->
    <div class="inspector-panel">
        <h3><i class="fas fa-search"></i> {{localize "ionrift-resonance.cascade.inspectorTitle"}}</h3>
        <p>{{{localize "ionrift-resonance.cascade.inspectorDetecting"}}}</p>
        <p>{{{localize "ionrift-resonance.cascade.inspectorInjecting"}}}</p>
    </div>
</div>