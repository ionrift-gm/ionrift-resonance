<div class="syrinscape-provider-panel">

    {{!-- Card A: Foundry Audio --}}
    <div class="syrinscape-provider-card syrinscape-provider-card--foundry{{#if isFoundryActive}} is-active{{else}} is-inactive{{/if}}{{#if expandFoundry}} is-expanded{{/if}}">

        <div class="foundry-toggle syrinscape-provider-toggle" data-panel="foundry">
            <span class="syrinscape-provider-toggle-label">
                <i class="fas fa-volume-up"></i>
                <span class="syrinscape-provider-title-block">
                    <span class="syrinscape-provider-title">{{localize "ionrift-resonance.syrinscape.cardFoundryTitle"}}</span>
                    <span class="syrinscape-provider-tagline">{{localize "ionrift-resonance.syrinscape.cardFoundryTagline"}}</span>
                </span>
            </span>
            <span class="syrinscape-provider-toggle-meta">
                {{#if isFoundryActive}}
                <span class="syrinscape-provider-status syrinscape-provider-status--active">
                    <i class="fas fa-check-circle"></i> {{localize "ionrift-resonance.syrinscape.statusActive"}}
                </span>
                {{/if}}
                <i class="fas fa-chevron-{{#if expandFoundry}}down{{else}}right{{/if}} foundry-chevron syrinscape-provider-chevron"></i>
            </span>
        </div>

        <div class="foundry-section syrinscape-provider-body{{#if expandFoundry}} is-open{{/if}}">
            {{#if isFoundryActive}}
            <div class="syrinscape-provider-active-banner">
                <i class="fas fa-check-circle"></i>
                <span>{{localize "ionrift-resonance.syrinscape.foundryActiveBanner"}}</span>
            </div>
            {{else}}
            <p class="syrinscape-provider-note notes">
                {{#if isSyrinscapeActive}}
                {{localize "ionrift-resonance.syrinscape.foundryClearPrompt"}}
                {{else}}
                {{localize "ionrift-resonance.syrinscape.foundryLocalPrompt"}}
                {{/if}}
            </p>
            <button type="button" class="skip-provider-btn syrinscape-provider-action syrinscape-provider-action--select">
                <i class="fas fa-volume-up"></i> {{localize "ionrift-resonance.syrinscape.useFoundryAudioOnly"}}
            </button>
            {{/if}}
        </div>

    </div>

    {{!-- Card B: Syrinscape --}}
    <div class="syrinscape-provider-card syrinscape-provider-card--syrin{{#if isSyrinscapeActive}} is-active{{else}} is-inactive{{/if}}{{#if expandSyrin}} is-expanded{{/if}}">

        <div class="syrin-toggle syrinscape-provider-toggle syrinscape-provider-toggle--accent" data-panel="syrinscape">
            <span class="syrinscape-provider-toggle-label">
                <i class="fas fa-plug syrinscape-provider-toggle-icon"></i>
                <span class="syrinscape-provider-title-block">
                    <span class="syrinscape-provider-title">{{{localize "ionrift-resonance.syrinscape.cardSyrinTitle"}}}</span>
                    <span class="syrinscape-provider-tagline">{{localize "ionrift-resonance.syrinscape.cardSyrinTagline"}}</span>
                </span>
            </span>
            <span class="syrinscape-provider-toggle-meta">
                {{#if isSyrinscapeActive}}
                <span class="syrinscape-provider-status syrinscape-provider-status--active">
                    <i class="fas fa-check-circle"></i> {{localize "ionrift-resonance.syrinscape.statusActive"}}
                </span>
                {{/if}}
                <i class="fas fa-chevron-{{#if expandSyrin}}down{{else}}right{{/if}} syrin-chevron syrinscape-provider-chevron"></i>
            </span>
        </div>

        <div class="syrin-section syrinscape-provider-body syrinscape-provider-body--syrin{{#if expandSyrin}} is-open{{/if}}">

            {{#if isSyrinscapeActive}}
            <div class="syrinscape-provider-active-banner">
                <i class="fas fa-check-circle"></i>
                <span>{{localize "ionrift-resonance.syrinscape.syrinActiveBanner"}}</span>
            </div>
            {{/if}}

            <p class="syrinscape-provider-note notes">
                {{#if isSyrinscapeActive}}
                {{localize "ionrift-resonance.syrinscape.syrinActiveNote"}}
                {{else}}
                {{localize "ionrift-resonance.syrinscape.syrinInactiveNote"}}
                {{/if}}
            </p>

            <label class="syrinscape-token-label">{{localize "ionrift-resonance.syrinscape.authTokenLabel"}}</label>

            <div class="syrinscape-token-row">
                <input type="password" name="authToken" class="attunement-token-input syrinscape-token-input" value="{{token}}"
                    placeholder="{{localize "ionrift-resonance.syrinscape.tokenPlaceholder"}}">
                <button type="button" class="toggle-visibility syrinscape-token-visibility" title="{{localize "ionrift-resonance.syrinscape.showToken"}}">
                    <i class="fas fa-eye"></i>
                </button>
            </div>

            <button type="button" class="verify-syrinscape-btn syrinscape-provider-action syrinscape-provider-action--primary">
                <i class="fas fa-plug"></i> {{#if isSyrinscapeActive}}{{localize "ionrift-resonance.syrinscape.reverifyBtn"}}{{else}}{{{localize "ionrift-resonance.syrinscape.verifyConnectBtn"}}}{{/if}}
            </button>

            {{#if mismatch}}
            <div class="syrinscape-inline-notice syrinscape-inline-notice--warning">
                <i class="fas fa-exclamation-triangle"></i>
                {{{localize "ionrift-resonance.syrinscape.mismatchNotice"}}}
            </div>
            {{/if}}

            {{#if hasSyrinControl}}
            <div class="syrinscape-inline-notice syrinscape-inline-notice--info">
                <i class="fas fa-link"></i>
                {{{localize "ionrift-resonance.syrinscape.controlDetectedNotice"}}}
            </div>
            {{/if}}

            <p class="syrinscape-token-help">
                {{{localize "ionrift-resonance.syrinscape.tokenHelpHtml"}}}
            </p>

        </div>

    </div>

</div>
