<div class="sound-auditor-container">
    <header class="auditor-header">
        <p class="notes">
            {{{localize "ionrift-resonance.soundAuditor.notes"}}}
        </p>
        <button class="action-refresh"><i class="fas fa-sync"></i> {{localize "ionrift-resonance.soundAuditor.refreshList"}}</button>
    </header>

    <div class="table-container">
        <table class="ionrift-table">
            <thead>
                <tr>
                    <th>{{localize "ionrift-resonance.soundAuditor.thItem"}}</th>
                    <th>{{localize "ionrift-resonance.soundAuditor.thOwner"}}</th>
                    <th title="{{localize "ionrift-resonance.soundAuditor.thAtkTitle"}}">{{localize "ionrift-resonance.soundAuditor.thAtk"}}</th>
                    <th title="{{localize "ionrift-resonance.soundAuditor.thUseTitle"}}">{{localize "ionrift-resonance.soundAuditor.thUse"}}</th>
                    <th title="{{localize "ionrift-resonance.soundAuditor.thEqpTitle"}}">{{localize "ionrift-resonance.soundAuditor.thEqp"}}</th>
                    <th>{{localize "ionrift-resonance.soundAuditor.thActions"}}</th>
                </tr>
            </thead>
            <tbody>
                {{#each items}}
                <tr>
                    <td class="cell-name">
                        <img src="{{this.img}}" width="24" height="24"
                            style="vertical-align: middle; margin-right: 5px;" />
                        <strong>{{this.name}}</strong>
                    </td>
                    <td>{{this.actorName}}</td>

                    <td class="cell-center">{{#if this.attack}}<i class="fas fa-check text-green"></i>{{/if}}</td>
                    <td class="cell-center">{{#if this.use}}<i class="fas fa-check text-green"></i>{{/if}}</td>
                    <td class="cell-center">{{#if this.equip}}<i class="fas fa-check text-green"></i>{{/if}}</td>

                    <td class="cell-actions">
                        <a class="action-open" data-uuid="{{this.uuid}}" title="{{localize "ionrift-resonance.soundAuditor.openSheetTitle"}}"><i
                                class="fas fa-edit"></i></a>
                        <a class="action-clear" data-uuid="{{this.uuid}}" title="{{localize "ionrift-resonance.soundAuditor.clearFlagsTitle"}}"
                            style="color: #ef4444; margin-left: 8px;"><i class="fas fa-trash"></i></a>
                    </td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="6" style="text-align: center; color: #888; padding: 20px;">
                        {{localize "ionrift-resonance.soundAuditor.noCustomFlags"}}
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>

<style>
    .ionrift-table {
        width: 100%;
        border-collapse: collapse;
    }

    .ionrift-table th {
        text-align: left;
        padding: 8px;
        background: rgba(0, 0, 0, 0.2);
        border-bottom: 2px solid var(--color-border-light-2);
    }

    .ionrift-table td {
        padding: 6px 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .cell-center {
        text-align: center;
    }

    .text-green {
        color: #4ade80;
    }

    .auditor-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
</style>